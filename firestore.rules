rules_version = '2'

// TEST MODE: open read/write access for all clients until the date below.
// This is intentionally permissive for early development. Tighten before
// going to production and well before the expiry date.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.time < timestamp.date(2026, 7, 19);
    }
  }
}
